// tsconfig.json (repo root)
{
  "compilerOptions": {
    // --- language + module ---
    "target": "ES2022",                // baseline JS version; overridable per-project
    "module": "ESNext",                // baseline module kind; overridable
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,

    // --- type-checking ---
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    // --- project layout ---
    "baseUrl": ".",                    // allows path-aliases in child configs
    // (no "paths" here—put those in frontend/backend tsconfig)
  }
}
