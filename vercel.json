{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,

  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",

  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/src/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],

  "functions": {
    "backend/src/index.ts": {
      "runtime": "vercel-node@3.0.0",
      "maxDuration": 30,
      "memory": 1024
    }
  },

  "env": {
    "NODE_ENV": "production"
  }
}
