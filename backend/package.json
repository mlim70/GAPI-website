{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=./.env tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "email-worker": "tsx scripts/emailWorker.ts",
    "setup-cron": "tsx scripts/setupCron.ts",
    "migrate:priority-weights": "tsx scripts/migratePriorityWeights.ts",
    "debug:webhook": "tsx scripts/debugWebhook.ts",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:dev": "pm2 start ecosystem.config.js --env development",
    "pm2:start:prod": "pm2 start ecosystem.config.js --env production",
    "pm2:stop": "pm2 stop email-worker",
    "pm2:stop:dev": "pm2 stop email-worker-dev",
    "pm2:restart": "pm2 restart email-worker",
    "pm2:restart:dev": "pm2 restart email-worker-dev",
    "pm2:logs": "pm2 logs email-worker",
    "pm2:logs:dev": "pm2 logs email-worker-dev",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit",
    "pm2:delete": "pm2 delete email-worker",
    "pm2:delete:dev": "pm2 delete email-worker-dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "@types/validator": "^13.15.2",
    "axios": "^1.11.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.2.1",
    "multer": "^1.4.5-lts.1",
    "stripe": "^16.0.0",
    "validator": "^13.15.15"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^18.19.120",
    "cross-env": "^10.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.2.0",
    "ts-jest": "^29.4.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3"
  }
}
