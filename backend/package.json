{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p .",
    "seed:levels": "tsx scripts/seed-membership-levels.ts",
    "sync:stripe": "tsx scripts/sync-stripe-levels.ts",
    
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:check-mongo": "node scripts/check-mongo.js",
    "test:setup": "echo 'Create a .env.test file in the backend directory with your MONGODB_URI' && echo 'Example: MONGODB_URI=mongodb://localhost:27017/gapi'",
    
    "test:simple": "tsx tests/simple-test-runner.ts",
    "test:comprehensive": "tsx tests/comprehensive-test-runner.ts",
    "test:detailed": "tsx tests/detailed-scenario-tests.ts",
    "test:manual": "tsx manual_tests.ts",
    
    "test:all": "npm run test:simple && npm run test:comprehensive && npm run test:detailed && npm run test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "@aws-sdk/s3-request-presigner": "^3.850.0",
    "body-parser": "^1.20.1",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "mongodb": "^6.18.0",
    "mongoose": "^7.2.1",
    "multer": "^1.4.5-lts.1",
    "stripe": "^16.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.7",
    "@types/node": "^18.19.120",
    "@types/supertest": "^2.0.16",
    "jest": "^29.7.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.3"
  }
}
