// backend/tsconfig.json
{
    "compilerOptions": {
      "module": "node16",
      "moduleResolution": "node16",
      "target": "ES2020",
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "outDir": "dist",
      "rootDir": "src",
      "skipLibCheck": true,
      "baseUrl": ".",
      "paths": {
        "@models/*": ["src/models/*"],
        "@routes/*": ["src/routes/*"],
        "@lib/*": ["src/lib/*"],
        "@utils/*": ["src/utils/*"]
      }
    },
    "include": ["src"]
  }
  